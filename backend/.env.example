# Django 核心配置
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置
DB_NAME=kitchen_detection_system
DB_USER=root
DB_PASSWORD=your-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# 邮箱配置
EMAIL_USER=your-email@qq.com
EMAIL_PASS=your-email-auth-code

# 微服务端口配置
PYTHON_APP_PORT=8081
JAVA_OCR_PORT=8080
PYTHON_OCR=5000

# Janus AI服务配置
JANUS_SERVICE_URL=http://localhost:5001
JANUS_TIMEOUT=60

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 可选配置
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans
# YOLO_DEVICE=cuda:0