# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Force these to always use LF (prevents CRLF issues across OS)
*.py        text eol=lf
*.js        text eol=lf
*.vue       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf

# Windows batch files need CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary files (don't diff, don't normalize)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pt        binary
*.pth       binary
*.jar       binary
*.exe       binary
*.dll       binary
*.pdb       binary
*.rdb       binary

# GitHub language statistics — mark these as non-source
*.sql       linguist-detectable=false
package-lock.json  linguist-generated
*.json linguist-language=JSON